#: aiosend.webhook.flask_manager.FlaskManager.register_handler:1
#: aiosend.webhook.litestar_manager.LitestarManager.register_handler:1
#: aiosend.webhook.starlette_manager.StarletteManager.register_handler:1 of
msgid "Register webhook handler."
msgstr "Зареєструвати обробник вебхуків."

#: aiosend.webhook.base.WebhookManager.register_handler:3 of
msgid ""
"Override this method in your own webhook manager class. This method is "
"used for registering webhook handler in your app."
msgstr ""
"Перевизначте цей метод у власному класі менеджера вебхуків. Він "
"використовується для реєстрації обробника вебхуків у вашому застосунку."

