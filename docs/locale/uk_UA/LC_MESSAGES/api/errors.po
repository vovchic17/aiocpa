#: aiosend.exceptions.APIError:1 of
msgid "Exception for API errors."
msgstr "Виняток, що виникає при помилках API."

#: aiosend.exceptions.APITimeoutError:1 of
msgid "Exception raised when the API request times out."
msgstr "Виняток, що виникає при перевищенні часу очікування запиту до API."

#: aiosend.exceptions.CryptoPayError:1 of
msgid "Bases: :py:class:`Exception`"
msgstr "Базовий клас: :py:class:`Exception`"

#: aiosend.exceptions.CryptoPayError:1 of
