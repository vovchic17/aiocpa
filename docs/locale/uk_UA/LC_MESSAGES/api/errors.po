msgstr "Базовий клас для винятків цього модуля."

#: aiosend.exceptions.DeserializationError:1 of
msgid "Exception for deserialization errors."
msgstr "Виняток, що виникає при помилках десеріалізації."

#: aiosend.exceptions.HTTPError:1 of
msgid "Exception raised for unexpected HTTP responses."
msgstr "Виняток, що виникає при отриманні неочікуваної HTTP-відповіді."

#: aiosend.exceptions.MethodValuesError:1 of
msgid "Exception raised when method values are invalid."
msgstr "Виняток, що виникає при передаванні недопустимих значень методу."

#: aiosend.exceptions.WrongNetworkError:1 of
