msgid "Bases: :py:class:`~aiosend.exceptions.CryptoPayError`"
msgstr "Базовый класс: :py:class:`~aiosend.exceptions.CryptoPayError`"

#: aiosend.exceptions.APIError:1 of
msgid "Exception for API errors."
msgstr "Исключение, возникающее при ошибках API."

#: aiosend.exceptions.APITimeoutError:1 of
msgid "Exception raised when the API request times out."
msgstr "Исключение, возникающее при превышении времени ожидания запроса к API."

#: aiosend.exceptions.CryptoPayError:1 of
msgid "Bases: :py:class:`Exception`"
msgstr "Базовый класс: :py:class:`Exception`"

#: aiosend.exceptions.CryptoPayError:1 of
msgid "Base class for exceptions in this module."
msgstr "Базовый класс для исключений этого модуля."

#: aiosend.exceptions.DeserializationError:1 of
msgid "Exception for deserialization errors."
msgstr "Исключение, возникающее при ошибках десериализации."

#: aiosend.exceptions.HTTPError:1 of
msgid "Exception raised for unexpected HTTP responses."
msgstr "Исключение, возникающее при получении непредвиденного HTTP-ответа."

#: aiosend.exceptions.MethodValuesError:1 of
msgid "Exception raised when method values are invalid."
msgstr "Исключение, возникающее при передаче недопустимых значений метода."

#: aiosend.exceptions.SuspendedError:1 of
msgid "Exception raised when the Crypto pay app is suspended."
msgstr "Исключение, возникающее, когда приложение Crypto Pay приостановлено."

#: aiosend.exceptions.WrongNetworkError:1 of
msgid "Exception raised when the token is served by different network."
msgstr "Исключение, возникающее, если токен относится к другой сети."

